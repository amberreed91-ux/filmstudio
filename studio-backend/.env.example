# Application
DEMO_MODE=true
LOG_FORMAT=text
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8010
CORS_ORIGINS=

# Authentication
ADMIN_TOKEN=change-me-to-a-secure-random-string
SESSION_TTL_SECONDS=86400

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Providers (required for full functionality)
# Canonical generation engine: Runway. All image/storyboard/previs tasks
# route exclusively through Runway (gen4_image); DashScope/Qwen/Wan are retired.
RUNWAYML_API_SECRET=
RUNWAY_API_KEY=
RUNWAY_API_ENABLED=true
DEFAULT_IMAGE_PROVIDER=runway
R43K_SOCKET_ONLY=1
# Legacy DashScope credential - transitional LLM/vision/TTS only; the
# image/storyboard/previs engine no longer reads it.
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=intl
DASHSCOPE_WORKSPACE_ID=

# Providers (optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=

# LLM Configuration
QWEN_LLM_MODEL=qwen3.7-max
QWEN_INTERNAL_TIMEOUT_SECONDS=12.0
OPENROUTER_LLM_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BACKUP_LLM_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Render Configuration
RENDER_VIDEO_PROVIDER=runway
RENDER_PROVIDER_CALL_TIMEOUT_SECONDS=310
SIMULATED_PROVIDER_ENABLED=true
MAX_CONCURRENT_JOBS=50

# Production Queue
PRODUCTION_QUEUE_ENABLED=true
PRODUCTION_QUEUE_WORKER_ENABLED=true
PRODUCTION_QUEUE_WORKER_POLL_INTERVAL_SECONDS=2.0
PRODUCTION_QUEUE_LEASE_SECONDS=300
PRODUCTION_QUEUE_MAX_BATCH_SIZE=5
PRODUCTION_QUEUE_GLOBAL_CONCURRENCY=4
PRODUCTION_QUEUE_PROJECT_CONCURRENCY=2
RENDER_POLL_BATCH_SIZE=50
RENDER_POLL_INTERVAL_SECONDS=10.0
RENDER_RECOVERY_HYDRATION_LIMIT=1000

# Database
STORAGE_PATH=./data
DB_POOL_SIZE=10

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_COUNT=7
BACKUP_DIR=./backups

# Error Telemetry (frontend)
VITE_ERROR_TELEMETRY_URL=
VITE_BUILD_VERSION=1.0.0

# MiniMax H3 local (Pinokio-managed ComfyUI) — scaffold only, disabled by default.
# Requires an NVIDIA/CUDA host plus a verified API-format H3 workflow before it
# can generate. No MiniMax subscription or API key is required for the local path.
MINIMAX_H3_LOCAL_ENABLED=false
MINIMAX_H3_LOCAL_URL=http://127.0.0.1:8188
# Path to a verified API-format H3 workflow. Leave unset until an H3 graph has
# been exported from ComfyUI in API format ("Save (API format)"); the bundled
# Pinokio workflows are UI format and cannot be submitted.
MINIMAX_H3_WORKFLOW_PATH=

# Local LTX via Phosphene (Pinokio-managed, Apple Silicon/MLX) — disabled by
# default. No subscription or API key is required for the local path.
LOCAL_LTX_ENABLED=false
LOCAL_LTX_URL=http://127.0.0.1:8198
LOCAL_LTX_MODEL=ltx-2.5-mlx-q4

# Muse Glimmer 30B — advisory chat/intelligence model for the Co-Director.
# When MUSE_API_KEY is set, Co-Director chat routes through Muse first and
# falls back to the Qwen-less configured chain (OpenRouter → Groq). Advisory
# only: Muse never renders and never mutates canonical project state.
MUSE_API_KEY=
MUSE_API_BASE_URL=https://integrate.api.nvidia.com/v1
MUSE_TIMEOUT_SECONDS=20

# NVIDIA hosted image generation (FLUX.2 Klein 4B) — model id flux.2-klein-4b
# on NVIDIA's OpenAI-compatible image API (NVIDIA NIM). Opt-in: set
# IMAGE_PROVIDER_ENABLED=true plus IMAGE_PROVIDER_NAME=nvidia to route image
# renders through NVIDIA behind the existing image provider seam (reference,
# approval, readiness, cost, and canonical-truth gates all still apply).
# The credential is read from this environment variable only — never commit it.
NVIDIA_API_KEY=
NVIDIA_IMAGE_API_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_IMAGE_TIMEOUT_SECONDS=120

# Runway hosted image generation (Gen-4 Image, model id gen4_image) on the
# Runway Dev API (POST /v1/text_to_image). Opt-in: set
# IMAGE_PROVIDER_ENABLED=true plus IMAGE_PROVIDER_NAME=runway to route image
# renders through Runway behind the existing image provider seam. Placeholders
# only — never place real credentials in tracked files. The credential is read
# from RUNWAY_API_KEY (falling back to the RUNWAYML_API_SECRET already used by
# Studio's Runway video workstream); it is never logged.
RUNWAY_API_KEY=
RUNWAY_IMAGE_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_IMAGE_TIMEOUT_SECONDS=180
RUNWAY_IMAGE_POLL_INTERVAL_SECONDS=5

# Runway Model Router (model-agnostic execution provider, provider id
# "runway_router"). Routes by saved-config slug sent as configId -- NEVER a
# concrete model, and NEVER the router resource UUID. The slug below is the
# authoritative Studio routing config; override only per deployment. Shares
# RUNWAY_API_KEY / RUNWAYML_API_SECRET with the other Runway surfaces.
RUNWAY_ROUTER_CONFIG_ID=studio-production-router
RUNWAY_ROUTER_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_ROUTER_TIMEOUT_SECONDS=300
RUNWAY_ROUTER_POLL_INTERVAL_SECONDS=5
RUNWAY_ROUTER_MAX_POLL_ATTEMPTS=120
RUNWAY_IMAGE_MAX_POLL_ATTEMPTS=60

# Image provider seam selection (providers/image_provider.py).
# Canonical default: Runway gen4_image for all image/storyboard/previs work.
IMAGE_PROVIDER_ENABLED=true
IMAGE_PROVIDER_NAME=runway
