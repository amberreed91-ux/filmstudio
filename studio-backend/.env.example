# Application
DEMO_MODE=true
LOG_FORMAT=text
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8010
CORS_ORIGINS=

# Authentication
ADMIN_TOKEN=change-me-to-a-secure-random-string
SESSION_TTL_SECONDS=86400

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Providers (required for full functionality)
RUNWAYML_API_SECRET=
RUNWAY_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=intl
DASHSCOPE_WORKSPACE_ID=

# Providers (optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=

# LLM Configuration
QWEN_LLM_MODEL=qwen3.7-max
QWEN_INTERNAL_TIMEOUT_SECONDS=12.0
OPENROUTER_LLM_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BACKUP_LLM_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Render Configuration
RENDER_VIDEO_PROVIDER=happyhorse
RENDER_PROVIDER_CALL_TIMEOUT_SECONDS=310
SIMULATED_PROVIDER_ENABLED=true
MAX_CONCURRENT_JOBS=50

# Production Queue
PRODUCTION_QUEUE_ENABLED=true
PRODUCTION_QUEUE_WORKER_ENABLED=true
PRODUCTION_QUEUE_WORKER_POLL_INTERVAL_SECONDS=2.0
PRODUCTION_QUEUE_LEASE_SECONDS=300
PRODUCTION_QUEUE_MAX_BATCH_SIZE=5
PRODUCTION_QUEUE_GLOBAL_CONCURRENCY=4
PRODUCTION_QUEUE_PROJECT_CONCURRENCY=2
RENDER_POLL_BATCH_SIZE=50
RENDER_POLL_INTERVAL_SECONDS=10.0
RENDER_RECOVERY_HYDRATION_LIMIT=1000

# Database
STORAGE_PATH=./data
DB_POOL_SIZE=10

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_COUNT=7
BACKUP_DIR=./backups

# Error Telemetry (frontend)
VITE_ERROR_TELEMETRY_URL=
VITE_BUILD_VERSION=1.0.0
