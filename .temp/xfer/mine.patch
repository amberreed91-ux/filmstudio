+        for rank, (_, character_id) in enumerate(ranked):
+            if rank == 0:
+                weights[character_id] = cls.SUBJECT_PROMINENCE
+            elif rank == 1:
+                weights[character_id] = cls.SECONDARY_PROMINENCE
+            else:
+                weights[character_id] = cls.BACKGROUND_PROMINENCE
+        return weights
